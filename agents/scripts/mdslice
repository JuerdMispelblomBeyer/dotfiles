#!/usr/bin/env python3
"""Print one Markdown section with a bounded byte budget."""

from __future__ import annotations

import argparse
from pathlib import Path
import re


def main() -> int:
    parser = argparse.ArgumentParser(prog="mdslice", description=__doc__)
    parser.add_argument("file", type=Path)
    parser.add_argument("heading", nargs="?")
    parser.add_argument("--max-bytes", type=int, default=12_000)
    args = parser.parse_args()
    lines = args.file.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True)
    headings = []
    for index, line in enumerate(lines):
        match = re.match(r"^(#{1,6})\s+(.+?)\s*$", line)
        if match:
            headings.append((index, len(match.group(1)), match.group(2).strip()))
    if not args.heading:
        for _, level, title in headings:
            print(f"{'  ' * (level - 1)}- {title}")
        return 0
    needle = args.heading.casefold()
    candidates = [item for item in headings if needle in item[2].casefold()]
    if not candidates:
        print(f"heading not found: {args.heading}")
        return 1
    if len(candidates) > 1:
        exact = [item for item in candidates if item[2].casefold() == needle]
        if len(exact) == 1:
            candidates = exact
        else:
            print("heading is ambiguous:")
            for _, _, title in candidates:
                print(f"- {title}")
            return 2
    start, level, _ = candidates[0]
    end = len(lines)
    for index, next_level, _ in headings:
        if index > start and next_level <= level:
            end = index
            break
    content = "".join(lines[start:end]).encode()
    if len(content) > args.max_bytes:
        print(content[: args.max_bytes].decode(errors="replace"), end="")
        print(f"\n[mdslice: truncated {len(content) - args.max_bytes} bytes]")
    else:
        print(content.decode(), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
