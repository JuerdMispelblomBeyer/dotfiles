#!/usr/bin/env bash
set -euo pipefail

max_matches=120
max_bytes=12000
globs=()
usage() {
  echo "usage: rgpack [--max-matches N] [--max-bytes N] [-g GLOB] PATTERN [PATH ...]"
}
while (($#)); do
  case "$1" in
    --max-matches) max_matches="$2"; shift 2 ;;
    --max-bytes) max_bytes="$2"; shift 2 ;;
    -g|--glob) globs+=("-g" "$2"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) break ;;
  esac
done
(($# >= 1)) || { usage >&2; exit 2; }
pattern="$1"; shift
paths=("${@:-.}")
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
set +e
rg --no-heading -n --color never --hidden -g '!**/.git/**' -g '!**/build/**' -g '!**/install/**' -g '!**/node_modules/**' "${globs[@]}" -- "$pattern" "${paths[@]}" >"$tmp"
rc=$?
set -e
if ((rc > 1)); then cat "$tmp" >&2; exit "$rc"; fi
total="$(wc -l <"$tmp")"
awk -v max="$max_matches" 'NR <= max { print }' "$tmp" | head -c "$max_bytes"
shown="$(awk -v max="$max_matches" 'END { print (NR < max ? NR : max) }' "$tmp")"
if ((total > shown)); then
  printf '\n[rgpack: %d of %d matches shown; narrow the search before increasing limits]\n' "$shown" "$total"
fi
exit "$rc"
