#!/usr/bin/env python3
"""Summarize retained Codex token counters and tool-result sizes."""

from __future__ import annotations

import argparse
from collections import defaultdict
from datetime import datetime, timedelta, timezone
import json
from pathlib import Path
import sys


def parse_since(value: str | None):
    if not value:
        return None
    if value.endswith("d") and value[:-1].isdigit():
        return datetime.now(timezone.utc) - timedelta(days=int(value[:-1]))
    if value.endswith("h") and value[:-1].isdigit():
        return datetime.now(timezone.utc) - timedelta(hours=int(value[:-1]))
    parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)


def human(value: float) -> str:
    for suffix, divisor in (("B", 1_000_000_000), ("M", 1_000_000), ("K", 1_000)):
        if value >= divisor:
            return f"{value / divisor:.2f}{suffix}"
    return str(int(value))


def load_lines(path: Path):
    with path.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                continue


def analyze_file(path: Path):
    session = {
        "path": str(path), "timestamp": None, "model": "unknown", "effort": "unknown",
        "calls": [], "usage": {}, "compactions": 0, "aborts": 0, "tools": defaultdict(lambda: [0, 0, 0]),
    }
    call_names: dict[str, str] = {}
    seen_cumulative: set[int] = set()
    for item in load_lines(path):
        item_type = item.get("type")
        payload = item.get("payload") or {}
        if item_type == "session_meta" and not session["timestamp"]:
            session["timestamp"] = payload.get("timestamp") or item.get("timestamp")
        if item_type == "turn_context" and session["model"] == "unknown":
            session["model"] = payload.get("model") or "unknown"
            session["effort"] = payload.get("effort") or payload.get("reasoning_effort") or "unknown"
        if item_type == "event_msg":
            event_type = payload.get("type")
            if event_type == "context_compacted":
                session["compactions"] += 1
            elif event_type == "turn_aborted":
                session["aborts"] += 1
            info = payload.get("info") or {}
            total_usage = info.get("total_token_usage") or {}
            last_usage = info.get("last_token_usage") or {}
            cumulative = total_usage.get("total_tokens")
            if isinstance(cumulative, int):
                if not session["usage"] or cumulative >= session["usage"].get("total_tokens", -1):
                    session["usage"] = total_usage
                if cumulative not in seen_cumulative and last_usage:
                    seen_cumulative.add(cumulative)
                    session["calls"].append(last_usage)
        if item_type == "response_item":
            response_type = payload.get("type")
            if response_type in {"function_call", "custom_tool_call"}:
                call_names[payload.get("call_id", "")] = payload.get("name") or "unknown"
            elif response_type in {"function_call_output", "custom_tool_call_output"}:
                name = call_names.get(payload.get("call_id", ""), "unknown")
                size = len(str(payload.get("output") or ""))
                stats = session["tools"][name]
                stats[0] += 1
                stats[1] += size
                stats[2] = max(stats[2], size)
    return session


def report(source: Path, since, top: int):
    paths = sorted(source.glob("sessions/**/*.jsonl")) + sorted(source.glob("archived_sessions/*.jsonl"))
    sessions = []
    for path in paths:
        analyzed = analyze_file(path)
        timestamp = analyzed["timestamp"]
        if since and timestamp:
            try:
                parsed = datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
                if parsed < since:
                    continue
            except ValueError:
                pass
        sessions.append(analyzed)

    totals = defaultdict(int)
    calls = defaultdict(int)
    by_profile = defaultdict(lambda: defaultdict(int))
    tools = defaultdict(lambda: [0, 0, 0])
    for session in sessions:
        usage = session["usage"]
        for key in ("input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens"):
            totals[key] += int(usage.get(key) or 0)
        totals["compactions"] += session["compactions"]
        totals["aborts"] += session["aborts"]
        profile = f"{session['model']} / {session['effort']}"
        by_profile[profile]["sessions"] += 1
        for usage_call in session["calls"]:
            calls["count"] += 1
            for key in ("input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens"):
                calls[key] += int(usage_call.get(key) or 0)
                by_profile[profile][key] += int(usage_call.get(key) or 0)
        for name, stats in session["tools"].items():
            tools[name][0] += stats[0]
            tools[name][1] += stats[1]
            tools[name][2] = max(tools[name][2], stats[2])

    input_tokens = totals["input_tokens"]
    result = {
        "source": str(source), "sessions": len(sessions), "totals": dict(totals), "calls": dict(calls),
        "cache_rate_percent": round(100 * totals["cached_input_tokens"] / input_tokens, 2) if input_tokens else 0,
        "uncached_input_tokens": input_tokens - totals["cached_input_tokens"],
        "profiles": {key: dict(value) for key, value in sorted(by_profile.items())},
        "tools": [
            {"name": name, "calls": stats[0], "total_chars": stats[1], "average_chars": round(stats[1] / stats[0]) if stats[0] else 0, "max_chars": stats[2]}
            for name, stats in sorted(tools.items(), key=lambda pair: pair[1][1], reverse=True)[:top]
        ],
    }
    return result


def print_report(data):
    totals, calls = data["totals"], data["calls"]
    print(f"sessions: {data['sessions']}")
    print(
        "tokens: "
        f"input={human(totals.get('input_tokens', 0))} "
        f"cached={human(totals.get('cached_input_tokens', 0))} "
        f"uncached={human(data['uncached_input_tokens'])} "
        f"output={human(totals.get('output_tokens', 0))} "
        f"reasoning={human(totals.get('reasoning_output_tokens', 0))} "
        f"cache_rate={data['cache_rate_percent']:.1f}%"
    )
    count = calls.get("count", 0)
    if count:
        print(
            f"model_calls: {count}; average input={human(calls.get('input_tokens', 0) / count)}, "
            f"uncached={human((calls.get('input_tokens', 0) - calls.get('cached_input_tokens', 0)) / count)}, "
            f"output={human(calls.get('output_tokens', 0) / count)}"
        )
    print(f"context: compactions={totals.get('compactions', 0)} aborted_turns={totals.get('aborts', 0)}")
    print("profiles:")
    for name, stats in data["profiles"].items():
        count = stats.get("sessions", 0)
        print(f"  {name}: sessions={count} calls_input={human(stats.get('input_tokens', 0))} output={human(stats.get('output_tokens', 0))}")
    print("largest tool-result categories (characters retained in session files):")
    for item in data["tools"]:
        print(f"  {item['name']}: calls={item['calls']} total={human(item['total_chars'])} avg={human(item['average_chars'])} max={human(item['max_chars'])}")
    print("note: retained operational counters are not a billing statement")


def main():
    parser = argparse.ArgumentParser(prog="codex-usage", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    report_parser = sub.add_parser("report")
    report_parser.add_argument("--source", type=Path, default=Path.home() / ".codex")
    report_parser.add_argument("--since", help="Duration such as 30d or ISO timestamp")
    report_parser.add_argument("--top", type=int, default=15)
    report_parser.add_argument("--json", type=Path, dest="json_path")
    args = parser.parse_args()
    data = report(args.source, parse_since(args.since), max(args.top, 0))
    print_report(data)
    if args.json_path:
        args.json_path.parent.mkdir(parents=True, exist_ok=True)
        args.json_path.write_text(json.dumps(data, indent=2) + "\n")
        print(f"json: {args.json_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
